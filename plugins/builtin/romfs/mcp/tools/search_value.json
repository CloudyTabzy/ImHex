{
    "name": "search_value",
    "description": "Scan the binary for numeric values (integers or floats) with configurable width, endianness, and sign. Supports exact match or range search.",
    "inputSchema": {
        "type": "object",
        "properties": {
            "start_address": {
                "type": "integer",
                "description": "Start address for the scan (default: 0)",
                "default": 0
            },
            "end_address": {
                "type": "integer",
                "description": "End address for the scan (default: end of file)",
                "default": 0
            },
            "width": {
                "type": "integer",
                "description": "Value width in bits: 8, 16, 32, or 64",
                "enum": [8, 16, 32, 64],
                "default": 32
            },
            "endian": {
                "type": "string",
                "description": "Byte order: 'little' or 'big'",
                "enum": ["little", "big"],
                "default": "little"
            },
            "signed": {
                "type": "boolean",
                "description": "Whether to interpret values as signed",
                "default": false
            },
            "value": {
                "type": "integer",
                "description": "Exact value to search for (use this OR min_value/max_value)"
            },
            "min_value": {
                "type": "integer",
                "description": "Minimum value for range search"
            },
            "max_value": {
                "type": "integer",
                "description": "Maximum value for range search"
            },
            "max_results": {
                "type": "integer",
                "description": "Maximum number of matches to return (1-10000)",
                "default": 1000
            }
        },
        "required": ["width"]
    }
}